# Copy to .env. These are the only keys needed by scripts/quickstart.py.
# Choose models, agents, search and limits in that script's CONFIG block.
DEEPSEEK_API_KEY=
EXA_API_KEY=

# Only if you choose an OpenRouter model or enable OpenRouter routing:
# OPENROUTER_API_KEY=
# ROUTE_VIA_OPENROUTER=true
# Any model ID on OpenRouter can be used once routing is on; the name is passed
# through verbatim. To pin a provider deployment (e.g. Baseten or Nebius):
# OPENROUTER_PROVIDER_ORDER=baseten
# Arbitrary request-body params (JSON) and per-role overrides:
# MODEL_EXTRA_BODY={"provider":{"order":["nebius"]}}
# MODEL_EXTRA_BODY_BY_ROLE={"subagent":{"provider":{"order":["baseten"]}}}

# If web_search_engine="tavily" or "both":
# TAVILY_API_KEY=

# If ResearchReddit is enabled:
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# If ResearchSubstack is enabled (Perplexity-backed search):
# PERPLEXITY_API_KEY=

# Contact details for specialist agents:
# PUBMED_EMAIL=
# SEC_EDGAR_CONTACT_EMAIL=
